{
    "name": "app-universe",
    "version": "0.1.0",
    "description": "人工精选的双语（EN/中文）工具目录站：31 款设计、游戏与效率工具",
    "license": "MIT",
    "private": true,
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cookabc/app-universe.git"
    },
    "keywords": [
        "nextjs",
        "react",
        "tailwindcss",
        "curated",
        "directory",
        "i18n",
        "typescript"
    ],
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
    "scripts": {
        "dev": "next dev -p 4000",
        "build": "next build",
        "start": "next start",
        "test": "node --experimental-strip-types --test",
        "lint": "biome check src",
        "lint:fix": "biome check --write src",
        "format": "biome format --write src",
        "format:check": "biome format src",
        "typecheck": "tsc --noEmit",
        "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
        "download-previews": "node scripts/download-previews.js",
        "optimize-previews": "node scripts/optimize-previews.js"
    },
    "dependencies": {
        "@phosphor-icons/react": "^2.1.10",
        "@radix-ui/react-tooltip": "^1.4.1",
        "clsx": "^2.1.1",
        "i18next": "^26.5.11",
        "i18next-browser-languagedetector": "^8.2.3",
        "next": "^16.4.3",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "postcss": "^8.5.31",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "typescript": "7.0.2"
    }
}
