{
  "name": "app-universe",
  "version": "0.1.0",
  "description": "人工精选的双语（EN/中文）工具目录站：30 款设计、游戏与效率工具",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookabc/app-universe.git"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwindcss",
    "curated",
    "directory",
    "i18n",
    "typescript"
  ],
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "download-previews": "node scripts/download-previews.js",
    "optimize-previews": "node scripts/optimize-previews.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-tooltip": "^1.4.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2"
  }
}
